# -------------------------------------------------------------------
# BUSINESS MAP BACKEND - ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit .env.
# All placeholders below are fake — replace them locally.
# -------------------------------------------------------------------

# 1. GEMINI API KEY (AI consultant)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE

# 2. GOOGLE MAPS API KEY (Geocoding, Places, Static Maps, Street View)
# https://console.cloud.google.com/ → enable Places, Geocoding, Maps Static, Street View Static
# Restrict this key by API + IP/referrer in production. Rotate if it ever touched git.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_KEY_HERE

# 3. HMAC secret for short-lived /v1/media/* photo proxy URLs (REQUIRED)
# Use a long random string (e.g. openssl rand -hex 32). Do not reuse the Maps key.
# App startup fails if this is missing or left as the placeholder below.
MEDIA_SIGNING_SECRET=YOUR_MEDIA_SIGNING_SECRET_HERE

# 4. Abuse protection (optional overrides — defaults are fine for demos)
# Public API root is /v1 (not /api/v1). Flutter BACKEND_BASE_URL must end with /v1/
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT_PER_MINUTE=60
# RATE_LIMIT_AI_PER_MINUTE=5
# RATE_LIMIT_MEDIA_PER_MINUTE=120
# MAX_REQUEST_BODY_BYTES=65536
# Only enable behind a reverse proxy that appends the real peer IP to X-Forwarded-For
# TRUST_PROXY_HEADERS=false
# Comma-separated browser origins for CORS (default *). Restrict in production.
# CORS_ORIGINS=*

# 5. PEXELS API KEY (business idea imagery)
# https://www.pexels.com/api/
PEXELS_API_KEY=YOUR_PEXELS_KEY_HERE

# 6. FIREBASE ADMIN SDK (Auth + optional Storage signed URLs)
# Option A — local file (path must stay under secrets/, which is gitignored)
FIREBASE_CREDENTIALS_PATH=secrets/firebase-service-account.json

# Option B — JSON string for hosts like Render (single line, no real values in this example)
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Storage bucket id (no gs:// prefix), used to sign AR model paths from business_type_data.json
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
