# Copy this file to `.env` and fill in values.
# Never commit `.env` — it is gitignored.
#
# Note: `.env` is bundled as a Flutter asset for runtime config.
# Restrict every client key in Google Cloud Console (package name + SHA-1 / bundle ID).
# Do NOT put server-only secrets here (Gemini, Firebase Admin, MEDIA_SIGNING_SECRET).

# Backend API root — must end with /v1/
# Android emulator → host machine: http://10.0.2.2:8000/v1/
# Physical device on LAN: http://<your-pc-lan-ip>:8000/v1/
# Deployed: https://your-backend.example.com/v1/
BACKEND_BASE_URL=

# Google Sign-In (Web / server client ID from Firebase / Google Cloud Console)
GOOGLE_CLIENT_ID=

# Google Maps (Android / iOS / AR WebView) — restrict by app package + SHA-1
MAPS_API_KEY=

# Google Cloud Translation API (TTS/Urdu flows) — prefer a separate restricted key
GOOGLE_TRANSLATE_API_KEY=

# Vercel Deployment Protection bypass (only if your backend uses it)
VERCEL_AUTOMATION_BYPASS_SECRET=

# Firebase (FlutterFire / Project settings → Your apps)
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
