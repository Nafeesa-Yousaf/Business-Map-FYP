rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos: each user may write only their own object.
    match /profile_images/{userId}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // AR .glb models are read via Admin-signed URLs from the backend.
    // Deny public client writes; allow authenticated reads if you serve without signed URLs.
    match /ar_models/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
